{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "pin",
  "pin": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDatasources": ["golang-version"],
      "separateMinorPatch": true,
      "rangeStrategy": "bump",
      "allowedVersions": "<1.28"
    }
  ]
}
