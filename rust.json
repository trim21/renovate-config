{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["rust-toolchain"],
      "semanticCommitType": "build"
    },
    {
      "matchManagers": ["cargo"],
      "matchDatasources": ["crate"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "groupName": "rust dependencies"
    }
  ]
}
